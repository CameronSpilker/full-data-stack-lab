# Required for live extracts. Free, from https://collegebasketballdata.com —
# register, then create a key. Never commit the real value.
# `ingest demo` needs no key and runs the whole pipeline offline.
CBD_API_KEY=

# Path to the DuckDB file every layer reads and writes.
DUCKDB_PATH=data/warehouse.duckdb

# Directory for raw Parquet extracts written by the ingestion layer.
RAW_DATA_DIR=data/raw

# Seconds to pause between API calls. Neither source publishes a rate limit,
# so this is politeness rather than compliance.
REQUEST_DELAY_SECONDS=0.4
