# Optional. Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# Create at https://github.com/settings/tokens with NO scopes — this project
# only reads public data. Never commit the real value.
GITHUB_TOKEN=

# Path to the DuckDB file every layer reads and writes.
DUCKDB_PATH=data/warehouse.duckdb

# Directory for raw Parquet extracts written by the ingestion layer.
RAW_DATA_DIR=data/raw
