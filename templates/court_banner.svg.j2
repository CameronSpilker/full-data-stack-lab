{#---
description: >
  The header every board opens with. A navy panel with half-court lines, the
  season it is reporting on, and the seven buttons that move between boards.
  The buttons live here rather than in each board, so adding a board is one
  line in this file instead of a row copied into seven.
options:
  current:
    type: string
    description: The board this banner sits on, by its label in the bar.
---#}
{#- Label and path for each board, in bar order. -#}
{% set boards = [
  ["Home", "/charts/"],
  ["Rankings", "/charts/rankings/"],
  ["Scorecard", "/charts/scorecard/"],
  ["Matchup", "/charts/matchup/"],
  ["Model", "/charts/model/"],
  ["Season", "/charts/season/"],
  ["Tournament", "/charts/tournament/"],
] %}
{% set navy = "#0c2340" %}
{% set orange = "#f47b20" %}
{% set line = "#ffffff" %}
{% set display = "'Oswald', 'Arial Narrow', 'Roboto Condensed', sans-serif" %}
{% set pad = 22 %}
{% set nav_h = 38 %}
{% set nav_y = height - pad - nav_h %}
{% set season = rows[0] if rows else none %}

<defs>
  <clipPath id="{{ uid }}-panel">
    <rect width="{{ width }}" height="{{ height }}" rx="14"/>
  </clipPath>
  <linearGradient id="{{ uid }}-glow" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#16345c"/>
    <stop offset="1" stop-color="{{ navy }}"/>
  </linearGradient>
</defs>

<g clip-path="url(#{{ uid }}-panel)">
  <rect width="{{ width }}" height="{{ height }}" fill="url(#{{ uid }}-glow)"/>

  {#- Half a court, drawn off the right edge: the key, the free-throw circle,
      the three-point arc and the basket. Faint, so it is texture rather than
      something to read. -#}
  {% set bx = width - 40 %}
  {% set by = height / 2 %}
  <g fill="none" stroke="{{ line }}" stroke-opacity="0.09" stroke-width="2">
    <rect x="{{ bx - 190 }}" y="{{ by - 60 }}" width="190" height="120"/>
    <circle cx="{{ bx - 190 }}" cy="{{ by }}" r="60"/>
    <path d="M {{ bx }} {{ by - 220 }} A 236 236 0 0 0 {{ bx }} {{ by + 220 }}"/>
    <circle cx="{{ bx - 16 }}" cy="{{ by }}" r="9"/>
    <line x1="{{ bx }}" y1="{{ by - 30 }}" x2="{{ bx }}" y2="{{ by + 30 }}"/>
    <circle cx="{{ bx - 520 }}" cy="{{ by }}" r="70"/>
    <line x1="{{ bx - 450 }}" y1="-10" x2="{{ bx - 450 }}" y2="{{ height + 10 }}"/>
  </g>

  {#- A ball, with its seams. -#}
  {% set cx = pad + 20 %}
  {% set cy = pad + 22 %}
  <g transform="translate({{ cx }} {{ cy }})">
    <circle r="20" fill="{{ orange }}"/>
    <g fill="none" stroke="{{ navy }}" stroke-width="1.8" stroke-linecap="round">
      <circle r="20"/>
      <line x1="-20" y1="0" x2="20" y2="0"/>
      <line x1="0" y1="-20" x2="0" y2="20"/>
      <path d="M -13 -15 C -5 -7 -5 7 -13 15"/>
      <path d="M 13 -15 C 5 -7 5 7 13 15"/>
    </g>
  </g>

  <text x="{{ cx + 34 }}" y="{{ cy - 4 }}" font-family="{{ display }}" font-size="13"
        font-weight="600" letter-spacing="2.2" fill="{{ orange }}">NCAA DIVISION I · MEN'S BASKETBALL</text>
  <text x="{{ cx + 34 }}" y="{{ cy + 16 }}" font-family="{{ display }}" font-size="16"
        font-weight="500" letter-spacing="0.6" fill="{{ line }}" fill-opacity="0.92">
    {%- if season -%}
      {{ season.season_label }} season · {{ season.phase_label }}
      {%- if season.last_game %} · last game {{ season.last_game }}{% endif %}
    {%- else -%}
      Full Data Stack Lab
    {%- endif -%}
  </text>

  {#- The bar. The button for this board is filled and is not a link. -#}
  {% set gap = 6 %}
  {% set slot = (width - 2 * pad - gap * (boards | length - 1)) / (boards | length) %}
  {% for b in boards %}
    {% set x = pad + loop.index0 * (slot + gap) %}
    {% if b[0] == options.current %}
      <rect x="{{ x }}" y="{{ nav_y }}" width="{{ slot }}" height="{{ nav_h }}" rx="8" fill="{{ orange }}"/>
      <text x="{{ x + slot / 2 }}" y="{{ nav_y + nav_h / 2 + 5 }}" text-anchor="middle"
            font-family="{{ display }}" font-size="14" font-weight="600" letter-spacing="1.4"
            fill="{{ navy }}">{{ b[0] | upper }}</text>
    {% else %}
      <a href="{{ b[1] }}">
        <rect x="{{ x }}" y="{{ nav_y }}" width="{{ slot }}" height="{{ nav_h }}" rx="8"
              fill="{{ line }}" fill-opacity="0.07" stroke="{{ line }}" stroke-opacity="0.16"/>
        <text x="{{ x + slot / 2 }}" y="{{ nav_y + nav_h / 2 + 5 }}" text-anchor="middle"
              font-family="{{ display }}" font-size="14" font-weight="500" letter-spacing="1.4"
              fill="{{ line }}" fill-opacity="0.88">{{ b[0] | upper }}</text>
      </a>
    {% endif %}
  {% endfor %}
</g>
