{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "redirects": [
    { "source": "/rankings", "destination": "/evidence/rankings", "permanent": true },
    { "source": "/scorecard", "destination": "/evidence/scorecard", "permanent": true },
    { "source": "/matchup", "destination": "/evidence/matchup", "permanent": true },
    { "source": "/picks", "destination": "/evidence/picks", "permanent": true },
    { "source": "/bracket", "destination": "/evidence/march-madness", "permanent": true },
    { "source": "/evidence/bracket", "destination": "/evidence/march-madness", "permanent": true },
    { "source": "/march-madness", "destination": "/evidence/march-madness", "permanent": true },
    { "source": "/conferences", "destination": "/evidence/conferences", "permanent": true },
    { "source": "/model", "destination": "/evidence/model", "permanent": true },
    { "source": "/how-it-works", "destination": "/evidence/how-it-works", "permanent": true },
    { "source": "/teams/:path*", "destination": "/evidence/teams/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/charts", "destination": "https://lab-charts-live.vercel.app/charts/" },
    { "source": "/charts/", "destination": "https://lab-charts-live.vercel.app/charts/" },
    { "source": "/charts/:board", "destination": "https://lab-charts-live.vercel.app/charts/:board/" },
    { "source": "/charts/:board/", "destination": "https://lab-charts-live.vercel.app/charts/:board/" }
  ]
}
